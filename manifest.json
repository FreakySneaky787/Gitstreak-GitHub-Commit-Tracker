{
  "manifest_version": 3,
  "name": "Gitstreak",
  "version": "2.0.0",
  "description": "Maintain your GitHub commit streak, Duolingo style! 🔥",
  "permissions": ["storage", "alarms", "notifications", "scripting"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gitstreak",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"]
    }
  ]
}